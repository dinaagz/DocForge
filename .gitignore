# DocForge
.docforge/state/*.json
.docforge/memory/*.jsonl
.docforge/model/*.json
.docforge/runtime/*
.docforge/audits/*.jsonl
.docforge/checklists/*.json
.docforge/completion/evidence.jsonl
.docforge/scores/*.json
!.docforge/scores/best/

# Input documents (fichiers source — ne pas versionner)
input/*.docx
input/*.pdf
input/*.odt
!input/.gitkeep

# Legacy Loop
state/*.json
!state/loop_state.example.json
!state/.gitkeep
logs/*
!logs/.gitkeep
work/*
!work/.gitkeep
output/*
!output/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# OS
.DS_Store
Thumbs.db
